# Prevent directory listing
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block direct access to sensitive internal directories if requested directly
    RewriteRule ^(config|scripts|node_modules)(\/|$) - [F,L,NC]

    # Rewrite all legitimate requests to the public directory if document root is repo root
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
