# Ensure index.php is used as the default directory index
DirectoryIndex index.php index.html

# Prevent MultiViews from intercepting clean URLs before mod_rewrite
Options -MultiViews
Options -Indexes

# Serve OpenJourney Format files as JSON
AddType application/json .ojf

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Dynamic Sitemap rules (public and authorized audit)
    RewriteRule ^audit-sitemap\.xml$ sitemap.php?include_auth=1 [L,QSA]
    RewriteRule ^sitemap\.xml$ sitemap.php [L,QSA]

    # Clean App Routes
    RewriteRule ^login/?$ login.php [L,QSA]
    RewriteRule ^signin/?$ login.php [L,QSA]
    RewriteRule ^register/?$ index.php?tab=register [L,QSA]
    RewriteRule ^signup/?$ index.php?tab=register [L,QSA]
    RewriteRule ^about/?$ about.php [L,QSA]
    RewriteRule ^admin/?$ admin.php [L,QSA]
    RewriteRule ^templates/?$ templates.php [L,QSA]
    RewriteRule ^invites/?$ invites.php [L,QSA]
    RewriteRule ^logout/?$ api/auth.php?action=logout [L,QSA]

    # Dashboard Routes (specific sub-routes first)
    RewriteRule ^dashboard/shared/?$ dashboard.php?tab=shared [L,QSA]
    RewriteRule ^dashboard/trash/?$ dashboard.php?tab=trash [L,QSA]
    RewriteRule ^dashboard/folder/([^/]+)/?$ dashboard.php?folder=$1 [L,QSA]
    RewriteRule ^dashboard/?$ dashboard.php?tab=my [L,QSA]

    # Journey Editor Routes (specific sub-routes first)
    RewriteRule ^journeys/?$ dashboard.php?tab=my [L,QSA]
    RewriteRule ^journey/([^/]+)/visual/?$ editor.php?id=$1&mode=visual [L,QSA]
    RewriteRule ^journey/([^/]+)/table/?$ editor.php?id=$1&mode=table [L,QSA]
    RewriteRule ^journey/([^/]+)/?$ editor.php?id=$1 [L,QSA]

    # Public Share Routes
    RewriteRule ^share/([^/]+)/?$ share.php?id=$1 [L,QSA]
    RewriteRule ^view/([^/]+)/?$ share.php?id=$1 [L,QSA]

    # Allow actual physical files and directories to be accessed directly (fall-through)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]
</IfModule>

# Browser Caching (WCAG / Performance Lighthouse cache-insight)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"

    # Static Assets (Versioned with cache-busting timestamps)
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"

    # Images & Icons
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType image/vnd.microsoft.icon "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"

    # Webfonts
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/ttf "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"
    ExpiresByType application/font-woff "access plus 1 year"

    # Dynamic / Data files
    ExpiresByType application/json "access plus 0 seconds"
    ExpiresByType application/xml "access plus 0 seconds"
    ExpiresByType text/xml "access plus 0 seconds"
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# Security Headers (OWASP Hardening) & Cache-Control Overrides
<IfModule mod_headers.c>
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-Content-Type-Options "nosniff"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set X-XSS-Protection "1; mode=block"
    Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"

    # Static Assets Cache-Control header (1 year TTL for efficient caching)
    <FilesMatch "\.(css|js|png|jpg|jpeg|gif|ico|svg|webp|woff2|woff|ttf)$">
        Header set Cache-Control "max-age=31536000, public, immutable"
    </FilesMatch>

    # Dynamic HTML & PHP pages
    <FilesMatch "\.(html|htm|php)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
    </FilesMatch>
</IfModule>
